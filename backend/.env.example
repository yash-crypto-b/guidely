# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app        # Comma-separated allowlist; Vercel preview origins are also accepted

# Supabase — server side (new-format API keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=                          # SECRET — sb_secret_... , backend only, bypasses RLS
# SUPABASE_JWT_SECRET=                         # optional — only if verifying tokens locally; default uses auth.getUser()
# SUPABASE_PUBLISHABLE_KEY=                    # sb_publishable_... — only needed to RUN the RLS integration test

# NVIDIA API (OpenAI-compatible endpoint) — server side
NVIDIA_API_KEY=                                # SECRET — nvapi-... , paste your NVIDIA API key here
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813  # Model to use for AI completions
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1  # Optional override

# Backwards-compatible aliases (deprecated — use NVIDIA_API_KEY above)
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_API_KEY=
AI_API_KEY=
AI_MODEL=

# Rate limiting — global
RATE_LIMIT_WINDOW_MS=900000                   # 15 min
RATE_LIMIT_MAX=100
# Rate limiting — AI endpoints (stricter; they cost money)
AI_RATE_LIMIT_WINDOW_MS=3600000               # 1 hour
AI_RATE_LIMIT_MAX=20
