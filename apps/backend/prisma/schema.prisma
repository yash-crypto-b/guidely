generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  CREATOR
  ADMIN
  SUPERADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionType {
  ONE_ON_ONE
  GROUP
}

enum AttributionSource {
  DIRECT
  MARKETPLACE
}

enum DeliveryType {
  VIDEO_CALL
  RESUME_REVIEW
  MOCK_INTERVIEW
  CAREER_GUIDANCE
  ASYNC_MESSAGE
  PORTFOLIO_REVIEW
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  name           String
  displayName    String?
  photoUrl       String?
  bio            String?
  headline       String?
  role           Role     @default(STUDENT)
  isVerified     Boolean  @default(false)
  googleId       String?  @unique
  refreshToken   String?
  timezone       String   @default("UTC")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Enhanced mentor profile fields
  company         String?
  industry        String?
  location        String?
  yearsExperience Int?
  languages       String[] @default([])
  linkedInUrl     String?
  portfolioUrl    String?
  hourlyRate      Int?

  creatorTags    CreatorTag[]
  socialLinks    SocialLink[]
  availability   Availability[]
  sessionTypes   SessionTypeDefinition[]
  creatorBookings Booking[]     @relation("CreatorBookings")
  studentBookings Booking[]     @relation("StudentBookings")
  reviewsGiven   Review[]       @relation("Reviewer")
  reviewsReceived Review[]      @relation("ReviewedCreator")
  messages       Message[]
  savedByUsers   SavedMentor[] @relation("SavedByUser")
  savedMentors   SavedMentor[] @relation("SavedMentorUser")
  stripeAccountId String?
  isActive       Boolean        @default(true)

  @@index([role, isActive])
  @@index([displayName])
  @@index([industry])
  @@index([yearsExperience])
}

model SocialLink {
  id        String @id @default(uuid())
  userId    String
  platform  String
  url       String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id       String @id @default(uuid())
  name     String @unique
  creators CreatorTag[]
}

model CreatorTag {
  id        String @id @default(uuid())
  creatorId String
  tagId     String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tag       Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([creatorId, tagId])
  @@index([tagId])
}

model SessionTypeDefinition {
  id          String      @id @default(uuid())
  creatorId   String
  title       String
  description String?
  duration    Int
  price       Int?
  isFree      Boolean     @default(false)
  type        SessionType @default(ONE_ON_ONE)
  maxGroupSize Int?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Connections service fields
  deliveryType    DeliveryType @default(VIDEO_CALL)
  maxBookingsPerDay Int?
  availableDays   Int[]         @default([1, 2, 3, 4, 5]) // 0=Sun, 1=Mon, ..., 6=Sat

  creator     User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([creatorId, isActive])
  @@index([deliveryType])
}

model Availability {
  id        String   @id @default(uuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlackoutDate {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model Booking {
  id               String        @id @default(uuid())
  creatorId        String
  studentId        String
  sessionTypeId    String
  status           BookingStatus @default(PENDING)
  startTime        DateTime
  endTime          DateTime
  totalAmount      Int?
  platformFee      Int?
  creatorEarnings  Int?
  stripePaymentIntentId String?
  meetingLink      String?
  meetingProvider  String?
  studentNotes     String?
  cancellationReason String?
  cancelledBy      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Connections attribution and commission fields
  attributionSource AttributionSource @default(MARKETPLACE)
  commissionRate    Int               @default(20)  // percentage
  bookingMetadata   String?           // mentee's "what would you like help with?"

  creator          User          @relation("CreatorBookings", fields: [creatorId], references: [id])
  student          User          @relation("StudentBookings", fields: [studentId], references: [id])
  sessionType      SessionTypeDefinition @relation(fields: [sessionTypeId], references: [id])
  messages         Message[]
  review           Review?
  payment          Payment?

  @@index([creatorId, startTime])
  @@index([studentId, startTime])
  @@index([status, startTime])
  @@index([attributionSource])
}

model Payment {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  stripePaymentIntentId String?
  stripeAccountId   String?
  amount            Int
  platformFee       Int      @default(0)
  creatorAmount     Int
  currency          String   @default("usd")
  status            String   @default("pending")
  stripeTransferId  String?
  refundedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  reviewerId  String
  creatorId   String
  rating      Int
  comment     String?
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  creator     User     @relation("ReviewedCreator", fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([rating])
}

model Message {
  id        String   @id @default(uuid())
  bookingId String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])
}

model SavedMentor {
  id       String @id @default(uuid())
  userId   String
  mentorId String
  savedAt  DateTime @default(now())

  user   User @relation("SavedByUser", fields: [userId], references: [id], onDelete: Cascade)
  mentor User @relation("SavedMentorUser", fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([userId, mentorId])
}

// ─── Search Performance Indexes ────────────────────────────────────────

model SearchIndex {
  id        String   @id @default(uuid())
  entityType String
  entityId   String
  content    String
  metadata   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([content])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  userId    String?
  sessionId String?
  data      Json?
  source    String?
  page      String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId])
  @@index([source])
}

model NotificationPreference {
  id        String  @id @default(uuid())
  userId    String
  emailReminders Boolean @default(true)
  inAppNotifications Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model PlatformConfig {
  id        String   @id @default("platform")
  feePercent Int     @default(0)
  platformName String @default("Guidely")
  supportEmail String @default("hello@guidely.dev")
  updatedAt DateTime @updatedAt
}
